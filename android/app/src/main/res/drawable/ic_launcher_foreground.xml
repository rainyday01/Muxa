<?xml version="1.0" encoding="utf-8"?>
<!--
  R5 #10 Ambient Coral Glow — FOREGROUND glyph only.

  Adaptive icons crop to ~66% center and many OEMs re-zoom the FG.
  Keep hex *small* (scale 0.42) so dark margins match the HTML card:
  small hex + prompt in a soft coral pinprick on black — not a full brown plate.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Design hex spans y=12..96 (height 84). scale 0.42 → ~35vp tall (~32% of canvas),
      well inside the 66% safe zone with dark breathing room after OEM zoom.
    -->
    <group
        android:translateX="54"
        android:translateY="53"
        android:scaleX="0.42"
        android:scaleY="0.42">
        <group
            android:translateX="-54"
            android:translateY="-54">

            <!-- Light hex outline (paper) -->
            <path
                android:fillColor="#00000000"
                android:strokeColor="#F0F7F6F3"
                android:strokeWidth="3.2"
                android:strokeLineJoin="round"
                android:pathData="M54,12 L90,32 L90,76 L54,96 L18,76 L18,32 Z" />
            <!-- Thin coral rim (subtle, not a filled brown shell) -->
            <path
                android:fillColor="#00000000"
                android:strokeColor="#55E16259"
                android:strokeWidth="1.4"
                android:strokeLineJoin="round"
                android:pathData="M54,12 L90,32 L90,76 L54,96 L18,76 L18,32 Z" />

            <!-- Prompt >_ -->
            <path
                android:fillColor="#00000000"
                android:strokeColor="#F7F6F3"
                android:strokeWidth="5"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M40,48 L50,58 L40,68" />
            <path
                android:fillColor="#00000000"
                android:strokeColor="#F7F6F3"
                android:strokeWidth="5"
                android:strokeLineCap="round"
                android:pathData="M52,68 H68" />
        </group>
    </group>
</vector>
