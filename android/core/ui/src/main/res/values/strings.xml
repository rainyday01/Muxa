    <string name="privacy_title">Privacy</string>
    <string name="privacy_s1_title">What we collect</string>
    <string name="privacy_s1_body">By default, nothing. Muxa has no accounts and no Muxa-operated servers. Hosts, snippets, keyboard layouts, and preferences stay on this device. SSH keys and passwords are stored in EncryptedSharedPreferences backed by the Android Keystore, and are not uploaded.</string>
    <string name="privacy_s2_title">Network</string>
    <string name="privacy_s2_body">Traffic goes only between this device and the SSH hosts you configure. Session content does not pass through Muxa-operated servers. Diagnostic logs are uploaded only when you send feedback yourself.</string>
    <string name="privacy_s3_title">Third parties and ads</string>
    <string name="privacy_s3_body">We do not collect, sell, or share personal data with ads or analytics. No third-party analytics, crash, or ad SDKs are embedded by default.</string>
    <string name="privacy_s4_title">Data you export</string>
    <string name="privacy_s4_body">Encrypted config export and diagnostic logs leave the device only if you save or share them. Muxa does not receive a copy unless you send it yourself.</string>
    <string name="privacy_s5_title">Deletion</string>
    <string name="privacy_s5_body">Deleting a host removes that host’s Keystore-backed secrets immediately. Delete all data on this device removes every Muxa secret and saved host. Uninstalling or clearing app data also removes EncryptedSharedPreferences and app Keystore keys.</string>
    <string name="privacy_policy_title">Privacy policy</string>
    <string name="privacy_policy_open">Open privacy policy</string>
    <string name="privacy_delete_all">Delete all data on this device</string>
